# Copy to .env.engine; keep secrets out of git.
# For a private cloud deployment set PUBLIC_MODE=1 and a persistent /data volume.
AYVEN_PUBLIC_MODE=0
AYVEN_API_TOKEN=
AYVEN_READ_TOKEN=
AYVEN_PUBLIC_URL=
# Fixture mode is for acceptance tests only. Live mode never falls back to fixtures.
AYVEN_LLM_STUB=1
AYVEN_RESEARCH_MODE=fixtures
AYVEN_USE_QWEN_AGENT=0
AYVEN_ALLOW_ESCALATION=0
# Live workforce endpoint (include /v1). Set STUB=0, RESEARCH_MODE=live.
AYVEN_LOCAL_LLM_BASE_URL=
AYVEN_LOCAL_LLM_API_KEY=
# json_object uses JSON mode plus local schema validation.
# openai sends strict json_schema; qwen includes local-runtime extensions.
AYVEN_PROVIDER_FORMAT=json_object
AYVEN_EMPLOYEE_MODEL=
AYVEN_SUPERVISOR_MODEL=
AYVEN_MANAGER_MODEL=
