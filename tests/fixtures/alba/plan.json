 "title": "Alba door price calculator",
 "brief": "TEST DATA. Build a clickable price calculator for Alba doors. Six-panel doors cost £85 each and cottage-style doors cost £90 each. The customer enters how many of each door they want, presses Calculate and sees the total in pounds.",
 "scope": "Clickable offline prototype only. No checkout, payment, accounts, stock or delivery.",
 "features": [
  "Quantity input for six-panel doors (£85 each)",
  "Quantity input for cottage-style doors (£90 each)",
  "Calculate button that shows the order total in pounds",
  "Quantities cannot be negative"
 ],
 "estimate": {
  "cost_gbp": 0,
  "timeline": "Same day (prototype)",
  "basis": "TEST DATA"
 },
